        <column alias='Training Score' caption='Biz Metric' datatype='string' name='[Parameter 6664887509721105]' param-domain-type='list' role='measure' type='nominal' value='&quot;Training Score&quot;'>
          <calculation class='tableau' formula='&quot;Training Score&quot;' />
          <aliases>
            <alias key='&quot;Coaching Sessions&quot;' value='Coaching Session' />
            <alias key='&quot;Training Score&quot;' value='Training Score' />
