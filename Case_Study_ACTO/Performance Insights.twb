            <column caption='Quadrant' datatype='string' name='[Training Quadrant (copy)_6664887512608789]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([Calculation_6664887510069266]) &gt;= [Calculation_6664887512887318] &#10;   AND AVG([SalesQuotaAttainment]) &gt;= ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Model Champions&apos; //Core Pillars (Top Right)&#10;&#10;ELSEIF AVG([Calculation_6664887510069266]) &lt; [Calculation_6664887512887318] &#10;   AND AVG([SalesQuotaAttainment]) &gt;= ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Practical Achievers&apos; //Operational Drivers (Top Left)&#10;&#10;ELSEIF AVG([Calculation_6664887510069266]) &lt; [Calculation_6664887512887318] &#10;   AND AVG([SalesQuotaAttainment]) &lt; ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Developing Talent&apos; //Growth Opportunities (Bottom Left)&#10;&#10;ELSE &apos;Untapped Potential&apos; //Bottom Right&#10;END' />
