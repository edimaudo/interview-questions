        <column caption='Status' datatype='string' name='[Calculation_5216624308482048]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([LeftCompanyDate])&#10;    OR [LeftCompanyDate] &gt; TODAY()&#10;THEN &quot;Active&quot;&#10;ELSE &quot;Left&quot;&#10;END' />
        </column>
        <column caption='Experience Bands' datatype='string' name='[Calculation_5216624312135682]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([Calculation_5216624312045569])&#10;THEN &quot;Unknown&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 1&#10;THEN &quot;Less than 1 year&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 3&#10;THEN &quot;Less than 3 years&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 5&#10;THEN &quot;Less than 5 years&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 10&#10;THEN &quot;Less than 10 years&quot;&#10;&#10;ELSE &quot;10+ years&quot;&#10;END' />
