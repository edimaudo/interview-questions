      <aliases enabled='yes' />
      <column caption='Assigned Product' datatype='string' name='[AssignedProduct]' role='dimension' type='nominal' />
      <column caption='Status' datatype='string' name='[Calculation_5216624308482048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([LeftCompanyDate])&#10;    OR [LeftCompanyDate] &gt; TODAY()&#10;THEN &quot;Active&quot;&#10;ELSE &quot;Left&quot;&#10;END' />
      </column>
      <column caption='Total Experience Years' datatype='real' name='[Calculation_5216624312045569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([YearsExperienceAtStart])&#10;    OR ISNULL([HireDate])&#10;    OR [HireDate] &gt; TODAY()&#10;THEN NULL&#10;&#10;ELSE [YearsExperienceAtStart]&#10;    + DATEDIFF(&apos;day&apos;, [HireDate], TODAY()) / 365.25&#10;END' />
      </column>
      <column caption='Experience Bands' datatype='string' name='[Calculation_5216624312135682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_5216624312045569])&#10;THEN &quot;Unknown&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 1&#10;THEN &quot;Less than 1 year&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 3&#10;THEN &quot;Less than 3 years&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 5&#10;THEN &quot;Less than 5 years&quot;&#10;&#10;ELSEIF [Calculation_5216624312045569] &lt; 10&#10;THEN &quot;Less than 10 years&quot;&#10;&#10;ELSE &quot;10+ years&quot;&#10;END' />
      </column>
      <column caption='Training Score Benchmark' datatype='real' name='[Calculation_5216624331231238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([TrainingScore]) }' />
      </column>
      <column caption='Quota Attainment Benchmark' datatype='real' name='[Calculation_5216624331333639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([SalesQuotaAttainment]) }' />
      </column>
      <column caption='Training Quadrant' datatype='string' name='[Calculation_5216624333819915]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([TrainingScore]) &gt;= ATTR([Calculation_5216624331231238]) &#10;   AND AVG([SalesQuotaAttainment]) &gt;= ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Model Champions&apos; //Core Pillars (Top Right)&#10;&#10;ELSEIF AVG([TrainingScore]) &lt; ATTR([Calculation_5216624331231238]) &#10;   AND AVG([SalesQuotaAttainment]) &gt;= ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Practical Achievers&apos; //Operational Drivers (Top Left)&#10;&#10;ELSEIF AVG([TrainingScore]) &lt; ATTR([Calculation_5216624331231238]) &#10;   AND AVG([SalesQuotaAttainment]) &lt; ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Developing Talent&apos; //Growth Opportunities (Bottom Left)&#10;&#10;ELSE  &apos;Untapped Potential&apos;//&apos;Technical Specialists (Bottom Right)&apos;&#10;END' />
      </column>
      <column caption='Training Score Level' datatype='boolean' name='[Calculation_6664887476191236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='( [Parameters].[Parameter 6664887475838979] = 1 AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &gt;= 0  AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &lt;= 25 ) OR&#10;( [Parameters].[Parameter 6664887475838979] = 2 AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &gt; 25  AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &lt;= 50 ) OR&#10;( [Parameters].[Parameter 6664887475838979] = 3 AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &gt; 50  AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &lt;= 75 ) OR&#10;( [Parameters].[Parameter 6664887475838979] = 4 AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &gt; 75  AND { FIXED [Name], [Year], [Quarter] : AVG([SalesQuotaAttainment]) } &lt;= 100 )' />
      </column>
      <column caption='Coaching Benchmark' datatype='real' name='[Calculation_6664887498625038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([total_coaching_sessions]) }' />
      </column>
      <column caption='Coaching Quadrant' datatype='string' name='[Calculation_6664887499083791]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([total_coaching_sessions]) &gt;= ATTR([Calculation_6664887498625038]) &#10;   AND AVG([SalesQuotaAttainment]) &gt;= ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Model Champions&apos; //Core Pillars (Top Right)&#10;&#10;ELSEIF AVG([total_coaching_sessions]) &lt; ATTR([Calculation_6664887498625038]) &#10;   AND AVG([SalesQuotaAttainment]) &gt;= ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Practical Achievers&apos; //Operational Drivers (Top Left)&#10;&#10;ELSEIF AVG([total_coaching_sessions]) &lt; ATTR([Calculation_6664887498625038]) &#10;   AND AVG([SalesQuotaAttainment]) &lt; ATTR([Calculation_5216624331333639]) &#10;   THEN &apos;Developing Talent&apos; //Growth Opportunities (Bottom Left)&#10;&#10;ELSE  &apos;Untapped Potential&apos;//&apos;Technical Specialists (Bottom Right)&apos;&#10;END' />
      </column>
      <column caption='Biz Metric Filter' datatype='real' name='[Calculation_6664887510069266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6664887509721105]&#10;  WHEN &apos;Training Score&apos; THEN [TrainingScore]&#10;  WHEN &apos;Coaching Sessions&apos; THEN [total_coaching_sessions]&#10;END' />
      </column>
